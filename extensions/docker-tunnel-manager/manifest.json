{
  "extensions": [
    {
      "id": "docker-tunnel-manager",
      "name": "Docker & Tunnel Manager",
      "description": "Manage Docker containers, images, volumes, and Cloudflare tunnels from a 7-tab panel.",
      "version": "0.1.0",
      "author": "ChonSong",
      "scripts": ["assets/docker-tunnel-manager.js"],
      "stylesheets": [],
      "capabilities": ["manifest-bundle", "loopback-sidecar"],
      "sidecar": {
        "type": "loopback",
        "origin": "http://127.0.0.1:17788",
        "health_path": "/health"
      },
      "permissions": {
        "dom": { "owned": true, "mutates_core_views": true },
        "storage": { "owned": true, "shared_webui_keys": [] },
        "webui_api": { "read": ["sessions"], "write": [] },
        "webui_navigation": false,
        "network_external": true,
        "filesystem": { "arbitrary": false, "serves_bundled_assets": true },
        "loopback_sidecar": true,
        "native_host": false
      },
      "lifecycle": {
        "webui_restart_required": false,
        "sidecar_start_required": true,
        "native_host_start_required": false,
        "native_host_autostart": "none"
      },
      "settings_schema": [
        {
          "key": "sidecar_origin",
          "type": "string",
          "label": "Sidecar origin",
          "default": "http://127.0.0.1:17788"
        },
        {
          "key": "auto_refresh_ms",
          "type": "integer",
          "label": "Auto-refresh interval (ms)",
          "default": 5000
        }
      ]
    }
  ]
}
